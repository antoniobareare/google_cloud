# Copia este archivo como .env y rellénalo. El .env NUNCA se sube al repo.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=MI_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
# Región para Cloud Run / Storage (los modelos van por GOOGLE_CLOUD_LOCATION)
REGION=europe-west1
# Nombre de la persona (para etiquetas y nombres de servicios de prueba)
OWNER=tu-nombre
